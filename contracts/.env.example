# RPC endpoints
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
BASE_RPC_URL=https://mainnet.base.org

# Etherscan V2 multichain key (works for Basescan) — https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Deployment parameters (read by script/Deploy.s.sol)
MAX_SUPPLY=1000
# Tiered mint price (comma separated). NFT #n costs the price of the first tier whose end >= n.
# Default: #1-100 = 1M, #101-200 = 2M, #201-300 = 5M, #301-1000 = 10M tokens (18 decimals).
TIER_ENDS=100,200,300,1000
TIER_PRICES_UNITS=1000000000000000000000000,2000000000000000000000000,5000000000000000000000000,10000000000000000000000000
# ERC-20 used to pay for mints; payments are burned to 0x...dEaD. Leave empty and
# set later with script/Admin.s.sol:SetPaymentToken once the token is live.
PAYMENT_TOKEN=
WALLET_LIMIT=5
UNREVEALED_URI=ipfs://REPLACE_WITH_HIDDEN_CID/hidden.json
ROYALTY_RECEIVER=0xYourSafeAddress
ROYALTY_BPS=500
# Mainnet: your Safe multisig. Testnet: can be your deployer address.
INITIAL_OWNER=0xYourSafeAddress

# Used by script/Admin.s.sol
LUNETTA_ADDRESS=
