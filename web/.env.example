# ---------- Public (exposed to the browser) ----------
# 4663 = Robinhood Chain mainnet (default), 46630 = Robinhood Chain testnet.
# Also supports 8453 / 84532 (Base) and 1 / 11155111 (Ethereum).
NEXT_PUBLIC_CHAIN_ID=4663
# The public RPC is rate-limited; use Alchemy/QuickNode/Dwellir for production traffic
NEXT_PUBLIC_RPC_URL=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
# https://cloud.reown.com — required by RainbowKit for WalletConnect
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
NEXT_PUBLIC_SITE_URL=https://lunetta.fun
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs/
NEXT_PUBLIC_X_URL=https://x.com/lunettacats
NEXT_PUBLIC_DISCORD_URL=https://discord.gg/yourinvite
# Leave empty until the game client is live ("Play" shows "Soon")
NEXT_PUBLIC_PLAY_URL=

# ---------- Server only ----------
# Postgres (Neon, Supabase, Vercel Postgres...). Must include sslmode=require in prod.
DATABASE_URL=postgres://user:pass@host:5432/lunetta?sslmode=require
WHITELIST_OPEN=true
# Optional ISO date after which submissions close automatically
WHITELIST_CLOSES_AT=
# Optional cap on registrations (0 = unlimited)
WHITELIST_MAX_SPOTS=0
# Upstash Redis for rate limiting (required in production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Salt for hashing IPs before storage (any long random string)
IP_HASH_SALT=change-me-to-a-long-random-string
